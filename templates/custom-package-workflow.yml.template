# ◈ custom-package-workflow.yml.template
#
# Copy this into .github/workflows/ in a fork (or a downstream repo that
# wants its own curated package set) and fill in the placeholders. It
# mirrors build-packages.yml exactly but builds from a different list file
# and publishes to a different release-tag prefix, so it can run
# side-by-side with the upstream workflow without colliding.
#
# Placeholders to fill in:
#   __PACKAGES_LIST__   e.g. "packages.desktop.list"
#   __TAG_PREFIX__      e.g. "desktop-binpkgs"
#   __GHPAGES_SUBDIR__  optional, if publishing multiple indexes from one
#                       repo, e.g. "desktop/" (leave blank for repo root)

name: Build __TAG_PREFIX__ packages

on:
  push:
    branches: [main]
    paths:
      - "__PACKAGES_LIST__"
  workflow_dispatch: {}

jobs:
  build-and-publish:
    runs-on: ubuntu-latest
    container:
      image: gentoo/stage3:musl-llvm
      options: --privileged
    env:
      GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      GITHUB_REPOSITORY: ${{ github.repository }}
    steps:
      - name: Clone repo (direct git, not actions/checkout)
        run: |
          git clone --depth 1 \
            "https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" \
            src
          cd src && git checkout "${{ github.sha }}"

      - name: Sync portage tree
        run: emerge-webrsync

      - name: Build packages
        working-directory: src
        run: |
          mkdir -p /var/cache/binpkgs
          python3 scripts/build-binpkg.py __PACKAGES_LIST__ /var/cache/binpkgs

      - name: Upload + publish
        working-directory: src
        run: |
          TAG="__TAG_PREFIX__-$(date -u +%Y%m%d)"
          python3 scripts/upload-release.py /var/cache/binpkgs "$TAG" /var/cache/binpkgs/upload-map.json
          python3 scripts/generate-packages-index.py \
            /var/cache/binpkgs/Packages /var/cache/binpkgs/upload-map.json \
            /var/cache/binpkgs/Packages.final
          # publish step: same gh-pages pattern as build-packages.yml,
          # writing to __GHPAGES_SUBDIR__/Packages if set
