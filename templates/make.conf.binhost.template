# ◈ Append this block to /etc/portage/make.conf to consume prebuilt
# AthanorOS packages instead of compiling everything from source.
#
# CORRECTED: this used to set PORTAGE_BINHOST directly here. That variable
# still works, but /etc/portage/binrepos.conf/ (see
# templates/binrepos.conf.template) is the current, documented mechanism
# for configuring remote binary repos — it supports multiple binhosts with
# priorities, which PORTAGE_BINHOST alone doesn't. Use that template
# instead of setting PORTAGE_BINHOST here.

FEATURES="${FEATURES} getbinpkg"

# Prefer binary packages when a matching build exists, fall back to source
# otherwise. Drop "y" -> "n" if you want binpkgs to be opt-in per package
# instead (then use --getbinpkg explicitly on the emerge command line).
EMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --getbinpkg=y --binpkg-respect-use=y"

# Optional but recommended: verify this repo's own GPG signature on the
# Packages index before trusting anything in it. This is separate from
# (and not a substitute for) binrepos.conf's own verify-signature option,
# which is disabled in templates/binrepos.conf.template — see that file's
# comments for why.
BINPKG_GPG_VERIFY_KEY="/etc/portage/gpg/athanor-binpkgs.pub.asc"
FEATURES="${FEATURES} binpkg-signing binpkg-request-signature"
